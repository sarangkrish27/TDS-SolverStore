# Copy this file to .env and fill in your values. Restart npm run dev afterward.
# Public Firebase web settings, served through /api/config at runtime.
# These are public by design. No VITE_ variables are required in Vercel.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=

# Private Firebase Admin SDK credentials: Project settings > Service accounts
# Project ID is shared by the public web configuration and server.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key JSON value as ONE quoted line with literal \n separators:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# Server-only administrator Google account. Never prefix this with VITE_.
ADMIN_EMAIL=
